{
  "set": "seed",
  "note": "Hand-written by the harness author, who knows the answers. For developing the pipeline only; never report its numbers as the result. Each need describes behavior without the target's identifier. targets: acceptable implementations as pkg:file#name (file '*' = any file in the package); [] means nothing in the corpus implements it.",
  "queries": [
    {
      "id": "duration-to-ms",
      "origin": "b11:add-durations",
      "need": "Convert a human-written duration such as '2h', '1.5 days' or '300ms' into a number of milliseconds; return undefined when the text is not a duration.",
      "inputs": [{ "name": "text", "type": "string" }],
      "output": "number | undefined",
      "examples": [
        { "args": ["2h"], "returns": 7200000 },
        { "args": ["1.5 days"], "returns": 129600000 },
        { "args": ["300ms"], "returns": 300 },
        { "args": ["soon"], "returns": { "$type": "undefined" } }
      ],
      "targets": ["ms-2.1.3:index.js#parse"]
    },
    {
      "id": "ms-to-short-duration",
      "origin": "b11:add-durations",
      "need": "Format a number of milliseconds as a compact duration with one unit: days, hours, minutes or seconds, rounded to a whole number (90 seconds becomes '2m'), or milliseconds when under one second.",
      "inputs": [{ "name": "ms", "type": "number" }],
      "output": "string",
      "examples": [
        { "args": [7200000], "returns": "2h" },
        { "args": [90000], "returns": "2m" },
        { "args": [500], "returns": "500ms" },
        { "args": [86400000], "returns": "1d" }
      ],
      "targets": ["ms-2.1.3:index.js#fmtShort"]
    },
    {
      "id": "bytes-to-base64",
      "origin": "b11:base64url-from-string",
      "need": "Encode an array of bytes as standard base64 text, padded with '='.",
      "inputs": [{ "name": "bytes", "type": "number[]" }],
      "output": "string",
      "examples": [
        { "args": [[102, 111, 111]], "returns": "Zm9v" },
        { "args": [[102]], "returns": "Zg==" },
        { "args": [[]], "returns": "" },
        { "args": [[255, 255]], "returns": "//8=" }
      ],
      "targets": ["base64-js-1.5.1:index.js#fromByteArray"]
    },
    {
      "id": "base64-encode-byte-range",
      "origin": "b11:base64url-from-string",
      "need": "Base64-encode the bytes of an array between a start index and an end index, where the range is a whole number of 3-byte groups, so no padding is needed.",
      "inputs": [
        { "name": "bytes", "type": "number[]" },
        { "name": "start", "type": "number" },
        { "name": "end", "type": "number" }
      ],
      "output": "string",
      "examples": [
        { "args": [[102, 111, 111, 98, 97, 114], 0, 6], "returns": "Zm9vYmFy" },
        { "args": [[0, 0, 0, 102, 111, 111], 3, 6], "returns": "Zm9v" }
      ],
      "targets": ["base64-js-1.5.1:index.js#encodeChunk"]
    },
    {
      "id": "int24-to-base64-chars",
      "origin": "b11:base64url-from-string",
      "need": "Turn a 24-bit integer into the four base64 characters that encode it.",
      "inputs": [{ "name": "value", "type": "number" }],
      "output": "string",
      "examples": [
        { "args": [6713199], "returns": "Zm9v" },
        { "args": [0], "returns": "AAAA" },
        { "args": [16777215], "returns": "////" }
      ],
      "targets": ["base64-js-1.5.1:index.js#tripletToBase64"]
    },
    {
      "id": "nodes-of-edge-list",
      "origin": "b11:build-order",
      "need": "Given a list of directed edges as [from, to] pairs, list every node that appears, each once, in order of first appearance.",
      "inputs": [{ "name": "edges", "type": "[string, string][]" }],
      "output": "string[]",
      "examples": [{ "args": [[["a", "b"], ["b", "c"], ["a", "c"]]], "returns": ["a", "b", "c"] }],
      "targets": ["toposort-2.0.2:index.js#uniqueNodes"]
    },
    {
      "id": "adjacency-from-edges",
      "origin": "b11:build-order",
      "need": "Build an adjacency map from a list of [from, to] edges: each node maps to the set of nodes it points to, and a node with no outgoing edges maps to an empty set.",
      "inputs": [{ "name": "edges", "type": "[string, string][]" }],
      "output": "Map<string, Set<string>>",
      "examples": [
        {
          "args": [[["a", "b"], ["b", "c"]]],
          "returns": {
            "$map": [["a", { "$set": ["b"] }], ["b", { "$set": ["c"] }], ["c", { "$set": [] }]]
          }
        }
      ],
      "targets": ["toposort-2.0.2:index.js#makeOutgoingEdges"]
    },
    {
      "id": "order-by-dependencies",
