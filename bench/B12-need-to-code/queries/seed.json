      "inputs": [
        { "name": "nodes", "type": "string[]" },
        { "name": "edges", "type": "[string, string][]" }
      ],
      "output": "string[]",
      "examples": [
        { "args": [["a", "b", "c"], [["a", "b"], ["b", "c"]]], "returns": ["a", "b", "c"] },
        { "args": [["x", "y"], [["x", "y"], ["y", "x"]]], "throws": true }
